    {
      "parameters": {
        "jsCode": "const ai = $node[\"AI Agent\"].json.output;\nlet d;\ntry { \n  const jsonMatch = ai.match(/\\{[\\s\\S]*\\}/);\n  d = JSON.parse(jsonMatch ? jsonMatch[0] : ai); \n} catch(e) { throw new Error('JSON no válido del Agente.'); }\n\nconst gv = (val) => (!val || String(val).trim() === '' || String(val).toLowerCase() === 'null') ? 'No disponible' : String(val).trim();\nconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst num = (v) => parseFloat(String(v || 0).replace(',','.')) || 0;\nconst q = String.fromCharCode(34);\nconst c = (t, v) => `<ss:Cell><ss:Data ss:Type=${q}${t}${q}>${v}</ss:Data></ss:Cell>`;\n\n// Columnas finales\nlet row = `<ss:Row>`;\nrow += c('String', esc(gv(d.numero_factura))); row += c('String', esc(gv(d.fecha_factura))); row += c('String', esc(gv(d.fecha_vencimiento)));\nrow += c('String', esc(gv(d.emisor_nombre))); row += c('String', esc(gv(d.emisor_cif))); row += c('String', esc(gv(d.emisor_direccion)));\nrow += c('String', esc(\"INNOVATEK- ALEX CALVO GARCIA Y OTRA CB C\")); row += c('String', esc(\"E20882726\")); row += c('String', esc(\"ZALDIZURRETA 19, AZPIA, BEASAIN, GIPUZKOA, 20200\"));\nrow += c('Number', String(num(d.base_imponible))); row += c('String', esc(gv(d.porcentaje_iva))); row += c('Number', String(num(d.cuota_iva)));\nrow += c('Number', String(num(d.total_factura))); row += c('String', esc(gv(d.forma_pago))); row += c('String', esc(gv(d.iban)));\nrow += `</ss:Row>`;\n\nlet xml = \"\";\ntry { xml = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf-8'); } catch (e) {}\nif (xml.includes('>' + esc(gv(d.numero_factura)) + '</ss:Data>')) return [{ json: { success: false, reason: 'Duplicada' } }];\n\nlet finalXml = \"\";\nconst tableEndTag = /<\\/(?:ss:)?Table\\s*>/i;\nif (xml && tableEndTag.test(xml)) {\n  finalXml = xml.replace(tableEndTag, row + '\\n</ss:Table>');\n} else {\n  const hc = (t) => `<ss:Cell><ss:Data ss:Type=\"String\">${t}</ss:Data></ss:Cell>`;\n  let header = `<ss:Row>` + hc('Nº Factura')+hc('Fecha')+hc('Vencimiento')+hc('Proveedor')+hc('CIF Prov')+hc('Dir Prov')+hc('Cliente')+hc('CIF Cliente')+hc('Dir Cliente')+hc('Base')+hc('% IVA')+hc('Cuota IVA')+hc('Total')+hc('Pago')+hc('IBAN') + `</ss:Row>`;\n  finalXml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?><?mso-application progid=\"Excel.Sheet\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Facturas\"><ss:Table>${header}${row}</ss:Table></Worksheet></Workbook>`;\n}\nreturn [{ json: { success: true }, binary: { data: { data: Buffer.from(finalXml, 'utf-8').toString('base64'), fileName: 'tabla_excell_facturas.xls' } } }];\n"
      },
