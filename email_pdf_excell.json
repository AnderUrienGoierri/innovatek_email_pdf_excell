    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"model\": \"llama3.2\", \"format\": \"json\", \"prompt\": \"Extract invoice data into a JSON object. IMPORTANT: 'factura_numero' is the unique reference ID of the invoice. 'factura_fecha' is the date of issue. Do not swap them. Fields: empresa_nombre, empresa_cif, empresa_direccion, empresa_cp, empresa_ciudad, empresa_provincia, empresa_telefono, empresa_email, cliente_nombre, cliente_cif, cliente_direccion, cliente_cp, cliente_ciudad, cliente_provincia, factura_numero, factura_fecha, base_imponible, iva_porcentaje, cuota_iva, total_factura, forma_pago, vencimiento, lineas: array of {descripcion, cantidad, precio_unitario, importe, iva_porcentaje}. Text: \" + (($json.ParsedResults && $json.ParsedResults[0] && $json.ParsedResults[0].ParsedText) || $json.text || '').replace(/[\\n\\r]/g, ' ').replace(/\\\"/g, '\\\\\\\"'), \"stream\": false }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1450, 0],
      "id": "b3000001-0001-0001-0001-000000000002",
      "name": "AI Extraer Datos Factura"
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/pdf_excell/tabla_excell_facturas.xls",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [1700, 0],
      "id": "b3000001-0001-0001-0001-000000000003",
      "name": "Leer Excel Existente",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $('AI Extraer Datos Factura').first().json.response; let d; try { d = JSON.parse(aiResponse.match(/\\{[\\s\\S]*\\}/)[0]); } catch(e) { throw new Error('Error IA: No se pudo leer el JSON de Ollama'); } let rawNum = String(d.factura_numero || '').trim(); let rawFec = String(d.factura_fecha || '').trim(); const isDatePattern = (s) => { const parts = s.split(/[\\-\\/\\.]/); return parts.length === 3 && parts.every(p => /^\\d+$/.test(p)); }; const isOnlyDigits = (s) => /^\\d+$/.test(s); if (isDatePattern(rawNum) && (isOnlyDigits(rawFec) || !rawFec)) { [rawNum, rawFec] = [rawFec, rawNum]; } const esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); const formatDate = (dateStr) => { if (!dateStr) return ''; const cleanDate = String(dateStr).split('T')[0].trim(); const parts = cleanDate.split(/[-/.]/); if (parts.length === 3) { if (parts[0].length === 4) return `${parts[2].padStart(2, '0')}-${parts[1].padStart(2, '0')}-${parts[0]}`; if (parts[2].length === 4) return `${parts[0].padStart(2, '0')}-${parts[1].padStart(2, '0')}-${parts[2]}`; } return dateStr; }; const f_numero = esc(rawNum); const f_fecha = formatDate(rawFec); const dirE = [d.empresa_direccion, d.empresa_cp, d.empresa_ciudad, d.empresa_provincia].filter(Boolean).join(', '); const dirC = [d.cliente_direccion, d.cliente_cp, d.cliente_ciudad, d.cliente_provincia].filter(Boolean).join(', '); const desc = (d.lineas || []).map(l => l.descripcion).filter(Boolean).join(' | ') || 'Factura'; let newRow = `<ss:Row><ss:Cell><ss:Data ss:Type=\"String\">${f_numero}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${f_fecha}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.empresa_nombre)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.empresa_cif)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(dirE)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.empresa_telefono)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.cliente_nombre)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.cliente_cif)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(dirC)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(desc)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">1</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">${parseFloat(d.base_imponible)||0}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">${parseFloat(d.base_imponible)||0}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">${parseFloat(d.iva_porcentaje)||0}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">${parseFloat(d.base_imponible)||0}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">${parseFloat(d.cuota_iva)||0}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"Number\">${parseFloat(d.total_factura)||0}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.forma_pago)}</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">${esc(d.vencimiento)}</ss:Data></ss:Cell></ss:Row>`; let xml = ''; const items = $input.all(); try { const buffer = await this.helpers.getBinaryDataBuffer(0, 'data'); if (buffer) xml = buffer.toString('utf-8'); } catch (err) { if (items[0].binary && items[0].binary.data && items[0].binary.data.data) xml = Buffer.from(items[0].binary.data.data, 'base64').toString('utf-8'); } const tableEndRegex = /(<\\/(?:ss:)?Table\\s*>)/i; if (xml && tableEndRegex.test(xml)) { xml = xml.replace(tableEndRegex, newRow + '\\n$1'); } else { xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?><?mso-application progid=\"Excel.Sheet\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Styles><Style ss:ID=\"Default\"><Font ss:FontName=\"Calibri\" ss:Size=\"11\"/></Style><Style ss:ID=\"header\"><Font ss:Bold=\"1\" ss:Color=\"#FFFFFF\" ss:FontName=\"Calibri\" ss:Size=\"11\"/><Interior ss:Color=\"#1F4E79\" ss:Pattern=\"Solid\"/><Alignment ss:Horizontal=\"Center\" ss:Vertical=\"Center\" ss:WrapText=\"1\"/></Style></Styles><Worksheet ss:Name=\"Facturas\"><Table><Column ss:Width=\"100\"/><Column ss:Width=\"90\"/><Column ss:Width=\"180\"/><Column ss:Width=\"110\"/><Column ss:Width=\"250\"/><Column ss:Width=\"100\"/><Column ss:Width=\"180\"/><Column ss:Width=\"110\"/><Column ss:Width=\"250\"/><Column ss:Width=\"200\"/><Column ss:Width=\"50\"/><Column ss:Width=\"80\"/><Column ss:Width=\"80\"/><Column ss:Width=\"50\"/><Column ss:Width=\"80\"/><Column ss:Width=\"80\"/><Column ss:Width=\"80\"/><Column ss:Width=\"100\"/><Column ss:Width=\"90\"/><ss:Row ss:Height=\"30\"><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Nº Factura</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Fecha</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Empresa</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">CIF Empresa</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Dir Empresa</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Tel</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Cliente</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">CIF Cliente</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Dir Cliente</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Desc</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Cant</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Precio</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Imp</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">%IVA</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Base</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Cuota</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Total</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Pago</ss:Data></ss:Cell><ss:Cell ss:StyleID=\"header\"><ss:Data ss:Type=\"String\">Venc</ss:Data></ss:Cell></ss:Row>' + newRow + '</Table></Worksheet></Workbook>'; } const buffer = Buffer.from(xml, 'utf-8'); return [{ json: { success: true }, binary: { data: { data: buffer.toString('base64'), mimeType: 'application/vnd.ms-excel', fileName: 'tabla_excell_facturas.xls', fileExtension: 'xls' } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1950, 0],
