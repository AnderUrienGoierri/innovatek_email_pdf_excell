{
  "name": "Facturación Final (Paperless + Excel)",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "folder",
        "path": "/n8n-watch/pdf_excell/entrada_facturas_pdf",
        "events": ["add"],
        "options": {"awaitWriteFinish": true, "usePolling": true}
      },
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "name": "Entrada"
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.path }}"
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [200, 0],
      "name": "Leer"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $binary.data.fileExtension.toLowerCase() }}",
              "operation": "equal",
              "value2": "pdf"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [400, 0],
      "name": "¿PDF?"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data"
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [600, -100],
      "name": "Texto"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.text }}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, -100],
      "name": "¿Vacío?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://paperless_webserver:8000/api/documents/post_document/",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "document",
              "inputDataFieldName": "data"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1000, 100],
      "name": "OCR"
    },
    {
      "parameters": { "amount": 10, "unit": "seconds" },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1200, 100],
      "name": "Espera"
    },
    {
      "parameters": {
        "url": "http://paperless_webserver:8000/api/documents/",
        "options": { "queryParameters": { "parameters": [{ "name": "page_size", "value": "1" }] } }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1400, 100],
      "name": "Resultado"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3.2', format: 'json', prompt: 'Extract JSON: ' + (($json.results && $json.results[0]) ? $json.results[0].content : ($json.text || '')).substring(0, 2000), stream: false }) }}",
        "options": { "timeout": 3600000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1650, 0],
      "name": "Ollama"
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/pdf_excell/tabla_excell_facturas.xls",
        "continueOnFail": true
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [1850, 0],
      "name": "Excel"
    },
    {
      "parameters": {
        "jsCode": "const ai = $('Ollama').first().json.response; let d; try { d = JSON.parse(ai.match(/\\{[\\s\\S]*\\}/)[0]); } catch(e) { throw new Error('No JSON'); } let n = String(d.factura_numero || '').trim(); let f = String(d.factura_fecha || '').trim(); const esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); const fD = (s) => { if (!s) return ''; const p = String(s).split(/[-/.]/); return p.length === 3 ? (p[0].length === 4 ? `${p[2]}-${p[1]}-${p[0]}` : `${p[0]}-${p[1]}-${p[2]}`) : s; }; const desc = (d.lineas || []).map(l => l.descripcion).join(' | ') || 'Factura'; let row = '<ss:Row><ss:Cell><ss:Data ss:Type=\"String\">' + esc(n) + '</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">' + fD(f) + '</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">' + esc(d.empresa_nombre) + '</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">' + esc(d.empresa_cif) + '</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">' + (parseFloat(d.total_factura)||0) + '</ss:Data></ss:Cell></ss:Row>'; let xml = ''; try { const b = await this.helpers.getBinaryDataBuffer(0, 'data'); if (b) xml = b.toString('utf-8'); } catch(e) {} const re = /(<\\/(?:ss:)?Table\\s*>)/i; if (xml && re.test(xml)) { xml = xml.replace(re, row + '\\n$1'); } else { xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?><?mso-application progid=\"Excel.Sheet\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Table><ss:Row><ss:Cell><ss:Data ss:Type=\"String\">Factura</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">Fecha</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">Empresa</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">CIF</ss:Data></ss:Cell><ss:Cell><ss:Data ss:Type=\"String\">Total</ss:Data></ss:Cell></ss:Row>' + row + '</Table></Workbook>'; } return [{ json: { success: true }, binary: { data: { data: Buffer.from(xml, 'utf-8').toString('base64'), mimeType: 'application/vnd.ms-excel', fileName: 'tabla_excell_facturas.xls', fileExtension: 'xls' } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2050, 0],
      "name": "Procesar"
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/data/pdf_excell/tabla_excell_facturas.xls"
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [2250, 0],
      "name": "Guardar"
    }
  ],
  "connections": {
    "Entrada": { "main": [[{ "node": "Leer", "type": "main", "index": 0 }]] },
    "Leer": { "main": [[{ "node": "¿PDF?", "type": "main", "index": 0 }]] },
    "¿PDF?": { "main": [[{ "node": "Texto", "type": "main", "index": 0 }], [{ "node": "OCR", "type": "main", "index": 0 }]] },
    "Texto": { "main": [[{ "node": "¿Vacío?", "type": "main", "index": 0 }]] },
    "¿Vacío?": { "main": [[{ "node": "OCR", "type": "main", "index": 0 }], [{ "node": "Ollama", "type": "main", "index": 0 }]] },
    "OCR": { "main": [[{ "node": "Espera", "type": "main", "index": 0 }]] },
    "Espera": { "main": [[{ "node": "Resultado", "type": "main", "index": 0 }]] },
    "Resultado": { "main": [[{ "node": "Ollama", "type": "main", "index": 0 }]] },
    "Ollama": { "main": [[{ "node": "Excel", "type": "main", "index": 0 }]] },
    "Excel": { "main": [[{ "node": "Procesar", "type": "main", "index": 0 }]] },
    "Procesar": { "main": [[{ "node": "Guardar", "type": "main", "index": 0 }]] }
  }
}